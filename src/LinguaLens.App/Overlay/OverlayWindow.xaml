<Window x:Class="LinguaLens.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LinguaLens.App.Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" Opacity="0" Visibility="Collapsed">
    <Border CornerRadius="10" Padding="0"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <!-- Close button — always on top, top-right corner -->
            <Button x:Name="CloseButton" Content="✕"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,6,0" Padding="4,1" FontSize="11"
                    Foreground="{DynamicResource TertiaryTextBrush}"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Panel.ZIndex="10"/>

            <!-- Loading shimmer -->
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Width="260" Margin="14">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="80" Height="16" CornerRadius="3" Background="{DynamicResource DividerBrush}" Margin="0,0,8,0"/>
                    <Border Width="40" Height="16" CornerRadius="3" Background="{DynamicResource DividerBrush}" Margin="0,0,8,0"/>
                    <Border Width="60" Height="16" CornerRadius="3" Background="{DynamicResource DividerBrush}"/>
                </StackPanel>
                <Separator Margin="0,0,0,10" Background="{DynamicResource DividerBrush}"/>
                <Border Width="160" Height="22" CornerRadius="3" Background="{DynamicResource DividerBrush}" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                <Border Width="230" Height="12" CornerRadius="3" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4" HorizontalAlignment="Left"/>
                <Border Width="180" Height="12" CornerRadius="3" Background="{DynamicResource DividerBrush}" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Border Width="70" Height="24" CornerRadius="3" Background="{DynamicResource DividerBrush}" Margin="0,0,6,0"/>
                    <Border Width="70" Height="24" CornerRadius="3" Background="{DynamicResource DividerBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Word card -->
            <local:WordCardView x:Name="WordCard" Visibility="Collapsed"/>

            <!-- Sentence card -->
            <local:SentenceCardView x:Name="SentenceCard" Visibility="Collapsed"/>

            <!-- Error panel -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="14" Width="240">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#x26A0;" FontSize="15" Foreground="#E24B4A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Не удалось получить перевод" FontSize="13" FontWeight="Medium"
                               Foreground="#A32D2D" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="Проверьте API ключ и соединение" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RetryButton" Content="Повторить"
                            Style="{StaticResource SmallOutlineButton}" Margin="0,0,6,0"/>
                    <Button x:Name="SettingsButton" Content="Настройки"
                            Style="{StaticResource SmallOutlineButton}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
