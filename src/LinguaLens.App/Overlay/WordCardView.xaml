<UserControl x:Class="LinguaLens.App.Overlay.WordCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize"   Value="{StaticResource FontSize.Label}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeight.Label}"/>
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0">

        <!-- ── Hint row ── -->
        <TextBlock Text="{Binding HintLabel, Converter={StaticResource LetterSpacedConverter}}"
                   Style="{StaticResource SectionLabelStyle}"
                   Margin="14,10,14,8"/>

        <!-- ── Card body ── -->
        <StackPanel Margin="14,0,14,12">

            <!-- ── Header: word + POS pill + transcription + flag ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: word + pos + transcription, all aligned to baseline -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Word}"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="{StaticResource FontSize.Word}"
                               FontWeight="{StaticResource FontWeight.Display}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>

                    <!-- POS capsule pill: UPPERCASE, бежевый фон, тёмный текст, тонкая рамка -->
                    <Border Margin="8,2,0,0"
                            Padding="{StaticResource PillPadding}"
                            CornerRadius="{StaticResource PillCornerRadius}"
                            Background="{DynamicResource PosBadgeBackgroundBrush}"
                            BorderBrush="{DynamicResource PrimaryTextBrush}"
                            BorderThickness="{StaticResource PillBorderThickness}"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasPos, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding PosUpper, Converter={StaticResource LetterSpacedConverter}}"
                                   FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="{StaticResource FontSize.Label}"
                                   FontWeight="{StaticResource FontWeight.Label}"
                                   Foreground="{DynamicResource PosBadgeForegroundBrush}"/>
                    </Border>

                    <TextBlock Text="{Binding Transcription}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="{StaticResource FontSize.Mono}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="8,2,0,0"
                               Visibility="{Binding HasTranscription, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Right: generic flag SVG (3-stripe) + lang code -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderBrush="{DynamicResource SecondaryTextBrush}"
                            BorderThickness="1"
                            CornerRadius="2"
                            Width="14" Height="10"
                            Background="Transparent"
                            VerticalAlignment="Center">
                        <Grid>
                            <Line X1="0" Y1="3" X2="14" Y2="3"
                                  Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="0.8"/>
                            <Line X1="0" Y1="6" X2="14" Y2="6"
                                  Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="0.8"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding LangCode}"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ── Dashed divider ── -->
            <Line X1="0" X2="1" Stretch="Fill"
                  Stroke="{DynamicResource LineSoftBrush}"
                  StrokeThickness="1.2"
                  StrokeDashArray="2 3"
                  Margin="0,12,0,10"/>

            <!-- ── Definition (large, primary block) ── -->
            <TextBlock Text="{Binding Definition}"
                       FontFamily="{StaticResource UiFontFamily}"
                       FontSize="15"
                       FontWeight="Normal"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       Visibility="{Binding HasDefinition, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- ── Translation (краткое слово/фраза с флажком) ── -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="→"
                           FontFamily="{StaticResource UiFontFamily}"
                           FontSize="{StaticResource FontSize.Translation}"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Translation}"
                           FontFamily="{StaticResource UiFontFamily}"
                           FontSize="{StaticResource FontSize.Translation}"
                           FontWeight="{StaticResource FontWeight.Display}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── Synonyms (исходный язык, из того же домена) ── -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                        Visibility="{Binding HasSynonyms, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Синонимы:"
                           FontFamily="{StaticResource UiFontFamily}"
                           FontSize="{StaticResource FontSize.Comment}"
                           Foreground="{DynamicResource TertiaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>
                <TextBlock Text="{Binding SynonymsLine}"
                           FontFamily="{StaticResource UiFontFamily}"
                           FontSize="{StaticResource FontSize.Comment}"
                           FontStyle="Italic"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ── Comment (доп. нюанс, если есть) ── -->
            <TextBlock Text="{Binding Comment}"
                       FontFamily="{StaticResource UiFontFamily}"
                       FontSize="{StaticResource FontSize.Comment}"
                       FontStyle="Italic"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       LineHeight="18"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- ── Examples (collapsed by default) ── -->
            <Expander Margin="0,12,0,0"
                      Visibility="{Binding HasExamples, Converter={StaticResource BoolToVisibilityConverter}}"
                      Foreground="{DynamicResource TertiaryTextBrush}">
                <Expander.Header>
                    <TextBlock Text="{Binding ExamplesHeader}"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="{StaticResource FontSize.Label}"
                               FontWeight="{StaticResource FontWeight.Label}"
                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Examples}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="{Binding Original}"
                                           FontFamily="{StaticResource UiFontFamily}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Translation}"
                                           FontFamily="{StaticResource UiFontFamily}"
                                           FontSize="{StaticResource FontSize.Caption}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!-- ── Dashed divider before footer ── -->
            <Line X1="0" X2="1" Stretch="Fill"
                  Stroke="{DynamicResource LineSoftBrush}"
                  StrokeThickness="1.2"
                  StrokeDashArray="2 3"
                  Margin="0,12,0,10"/>

            <!-- ── Footer: [＋ Сохранить]  [Перевести предложение] ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{Binding SaveButtonLabel}"
                        Command="{Binding SaveToVocabCommand}"
                        Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SmallOutlineButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="1"
                        Content="Перевести предложение"
                        Style="{StaticResource SmallOutlineButton}"
                        Command="{Binding TranslateSentenceCommand}"
                        HorizontalAlignment="Stretch"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
