<Window x:Class="LinguaLens.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — LinguaLens"
        Width="600" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <!-- ── Sidebar item: ToggleButton, выглядит как ghost-кнопка,
              в active state — paper-2 фон с тёмным border ── -->
        <Style x:Key="SidebarItemStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ChipCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PaperAltBrush}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Segmented pill: RadioButton в группе, capsule, dark = primary (фон=ink) ── -->
        <Style x:Key="SegmentedPillStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Label}"/>
            <Setter Property="FontWeight" Value="{StaticResource FontWeight.Label}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{StaticResource PillBorderThickness}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource PillCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CardBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Pill toggle (on/off): кастомный CheckBox в виде ползунка capsule ── -->
        <Style x:Key="PillToggleStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="32" Height="18"
                                Background="{DynamicResource PaperAltBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1.4"
                                CornerRadius="999">
                            <Grid>
                                <Ellipse x:Name="thumb" Width="11" Height="11"
                                         Fill="{DynamicResource CardBackgroundBrush}"
                                         Stroke="{DynamicResource CardBorderBrush}"
                                         StrokeThickness="1"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Margin="2,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section label style для разделов ── -->
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style x:Key="SettingHintStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ── Dashed divider ── -->
        <Style x:Key="DashedDividerStyle" TargetType="Line">
            <Setter Property="X1" Value="0"/>
            <Setter Property="X2" Value="1"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Stroke" Value="{DynamicResource LineSoftBrush}"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="StrokeDashArray" Value="2 3"/>
            <Setter Property="Margin" Value="0,10"/>
        </Style>
    </Window.Resources>

    <!-- Внешняя обёртка с paper-фоном и тенью -->
    <Border Margin="8"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="{StaticResource CardBorderThickness}"
            CornerRadius="{StaticResource CardCornerRadius}"
            Effect="{DynamicResource CardShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============== Header bar (custom chrome) ============== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PaperAltBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1.5"
                    CornerRadius="10,10,0,0"
                    Padding="16,12"
                    MouseLeftButtonDown="OnHeader_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Настройки"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseBtn"
                            Content="✕"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SmallOutlineButton}"
                            BorderBrush="Transparent"
                            Background="Transparent"
                            FontSize="13"
                            Padding="6,2"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- ============== Body: sidebar + content ============== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Sidebar ── -->
                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource LineSoftBrush}"
                        BorderThickness="0,0,1,0">
                    <StackPanel Margin="8,12">
                        <RadioButton x:Name="TabApi"        Style="{StaticResource SidebarItemStyle}"
                                     GroupName="SettingsTabs" Content="API" IsChecked="True"/>
                        <RadioButton x:Name="TabBehavior"   Style="{StaticResource SidebarItemStyle}"
                                     GroupName="SettingsTabs" Content="Поведение"/>
                        <RadioButton x:Name="TabAppearance" Style="{StaticResource SidebarItemStyle}"
                                     GroupName="SettingsTabs" Content="Внешний вид"/>
                        <RadioButton x:Name="TabSystem"     Style="{StaticResource SidebarItemStyle}"
                                     GroupName="SettingsTabs" Content="Система"/>
                        <RadioButton x:Name="TabUsage"      Style="{StaticResource SidebarItemStyle}"
                                     GroupName="SettingsTabs" Content="Использование"/>
                    </StackPanel>
                </Border>

                <!-- ── Content panels ── -->
                <Grid Grid.Column="1" Margin="18,14">

                    <!-- ===== API tab ===== -->
                    <StackPanel x:Name="ApiPanel">
                        <!-- Provider -->
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Провайдер LLM" Style="{StaticResource SettingLabelStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="ProviderGroq"   Style="{StaticResource SegmentedPillStyle}"
                                             GroupName="Provider" Content="Groq"/>
                                <RadioButton x:Name="ProviderGemini" Style="{StaticResource SegmentedPillStyle}"
                                             GroupName="Provider" Content="Gemini"/>
                            </StackPanel>
                        </Grid>

                        <!-- API key -->
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="API ключ" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Хранится локально в %AppData%" Style="{StaticResource SettingHintStyle}"/>
                            </StackPanel>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- masked password box (виден, когда ShowKey=false) -->
                                <PasswordBox x:Name="ApiKeyMasked"
                                             Grid.Column="0"
                                             FontFamily="{StaticResource MonoFontFamily}"
                                             FontSize="11"
                                             Padding="8,5"
                                             VerticalContentAlignment="Center"
                                             Background="{DynamicResource CardBackgroundBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}"
                                             BorderThickness="1.3"/>
                                <!-- plain text box (виден, когда ShowKey=true) -->
                                <TextBox x:Name="ApiKeyPlain"
                                         Grid.Column="0"
                                         FontFamily="{StaticResource MonoFontFamily}"
                                         FontSize="11"
                                         Padding="8,5"
                                         VerticalContentAlignment="Center"
                                         Background="{DynamicResource CardBackgroundBrush}"
                                         BorderBrush="{DynamicResource CardBorderBrush}"
                                         BorderThickness="1.3"
                                         Visibility="Collapsed"/>
                                <Button x:Name="ShowKeyBtn"
                                        Grid.Column="1"
                                        Content="показать"
                                        Style="{StaticResource SmallOutlineButton}"
                                        Margin="6,0,0,0"/>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- ===== Behavior tab ===== -->
                    <StackPanel x:Name="BehaviorPanel" Visibility="Collapsed">
                        <!-- Debounce -->
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Задержка наведения"
                                       Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="100" FontSize="10"
                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="DebounceSlider" Grid.Column="1"
                                        Minimum="100" Maximum="1000"
                                        VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True" TickFrequency="50"/>
                                <TextBlock Grid.Column="2" Text="1000" FontSize="10"
                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                                <TextBlock x:Name="DebounceValue" Grid.Column="3"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center"
                                           MinWidth="50" TextAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Определять английский"
                                       Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="DetectEnglishToggle" Grid.Column="1" Style="{StaticResource PillToggleStyle}"/>
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Определять испанский"
                                       Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="DetectSpanishToggle" Grid.Column="1" Style="{StaticResource PillToggleStyle}"/>
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Авто-сохранение в словарь"
                                       Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="AutoSaveToggle" Grid.Column="1" Style="{StaticResource PillToggleStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== Appearance tab ===== -->
                    <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Тема"
                                       Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource SegmentedPillStyle}"
                                             GroupName="Theme" Content="Светлая"/>
                                <RadioButton x:Name="ThemeDark"  Style="{StaticResource SegmentedPillStyle}"
                                             GroupName="Theme" Content="Тёмная"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ===== System tab ===== -->
                    <StackPanel x:Name="SystemPanel" Visibility="Collapsed">
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Горячая клавиша" Style="{StaticResource SettingLabelStyle}"/>
                                <TextBlock Text="Перевести по требованию" Style="{StaticResource SettingHintStyle}"/>
                            </StackPanel>
                            <TextBox x:Name="HotKeyBox" Grid.Column="1"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="11"
                                     Padding="8,5"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     BorderThickness="1.3"
                                     HorizontalAlignment="Left" MinWidth="160"/>
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Запускать с Windows"
                                       Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="StartWithWindowsToggle" Grid.Column="1" Style="{StaticResource PillToggleStyle}"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== Usage tab ===== -->
                    <StackPanel x:Name="UsagePanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource PaperAltBrush}"
                                BorderBrush="{DynamicResource LineSoftBrush}"
                                BorderThickness="1.2"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,4,0,12">
                            <StackPanel>
                                <TextBlock Text="Использование сегодня"
                                           FontFamily="{StaticResource UiFontFamily}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,8"/>
                                <ProgressBar x:Name="UsageBar"
                                             Height="8"
                                             Minimum="0" Maximum="100"
                                             Background="{DynamicResource CardBackgroundBrush}"
                                             BorderBrush="{DynamicResource CardBorderBrush}"
                                             BorderThickness="1.2"
                                             Foreground="{DynamicResource OkBrush}"
                                             Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UsageTokensText"
                                               Grid.Column="0"
                                               FontFamily="{StaticResource UiFontFamily}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                                    <TextBlock x:Name="UsageCostText"
                                               Grid.Column="1"
                                               FontFamily="{StaticResource UiFontFamily}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TertiaryTextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Дневной лимит (токены)"
                                       Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox x:Name="DailyLimitBox" Grid.Column="1"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="11"
                                     Padding="8,5"
                                     Background="{DynamicResource CardBackgroundBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}"
                                     BorderThickness="1.3"
                                     HorizontalAlignment="Left" Width="120"/>
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Предупреждать при 80%"
                                       Style="{StaticResource SettingLabelStyle}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="WarnAtEightyToggle" Grid.Column="1" Style="{StaticResource PillToggleStyle}"/>
                        </Grid>
                        <Button x:Name="ResetUsageBtn"
                                Content="Сбросить счётчик"
                                Style="{StaticResource SmallOutlineButton}"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>

    <!-- ── Save button — sticky bottom ── -->
    <!-- N/A: footer is inside the Grid above as a separate row; здесь мы кладём кнопку Сохранить
         в Header bar справа (рядом с ✕) на следующем этапе.
         Сейчас Save вызывается при закрытии окна (через CloseBtn). -->
</Window>
