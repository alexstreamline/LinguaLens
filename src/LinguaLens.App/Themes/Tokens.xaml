<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============== Font families ==============
         Inter и JetBrains Mono не входят в Windows.
         Используем family-fallback chain — WPF выберет первый установленный.
         На Win 11 fallback пойдёт на Segoe UI Variable, на Win 10 — на Segoe UI / Consolas. -->
    <FontFamily x:Key="UiFontFamily">Inter, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

    <!-- ============== Font sizes (device-independent pixels) ============== -->
    <sys:Double x:Key="FontSize.Word">22</sys:Double>          <!-- Word headline -->
    <sys:Double x:Key="FontSize.Translation">20</sys:Double>   <!-- Translation display -->
    <sys:Double x:Key="FontSize.SentenceBody">17</sys:Double>  <!-- Sentence translation body -->
    <sys:Double x:Key="FontSize.Body">14</sys:Double>          <!-- Sentence original body -->
    <sys:Double x:Key="FontSize.Comment">13</sys:Double>       <!-- Italic comment -->
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>       <!-- Examples, secondary text -->
    <sys:Double x:Key="FontSize.Mono">12</sys:Double>          <!-- Transcription -->
    <sys:Double x:Key="FontSize.Label">10</sys:Double>         <!-- Section labels, POS pill -->

    <!-- ============== Font weights ============== -->
    <FontWeight x:Key="FontWeight.Display">SemiBold</FontWeight>
    <FontWeight x:Key="FontWeight.Body">Normal</FontWeight>
    <FontWeight x:Key="FontWeight.Label">SemiBold</FontWeight>

    <!-- ============== Corner radii ============== -->
    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">6</CornerRadius>

    <!-- ============== Border thicknesses ============== -->
    <Thickness x:Key="CardBorderThickness">1.5</Thickness>
    <Thickness x:Key="ButtonBorderThickness">1.5</Thickness>
    <Thickness x:Key="PillBorderThickness">1.2</Thickness>

    <!-- ============== Spacing scale ============== -->
    <Thickness x:Key="CardPadding">16,14</Thickness>
    <Thickness x:Key="ButtonPadding">12,7</Thickness>
    <Thickness x:Key="PillPadding">8,2</Thickness>

</ResourceDictionary>
