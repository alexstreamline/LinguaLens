<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============== Surface / paper ============== -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#242220"/>
    <SolidColorBrush x:Key="PaperAltBrush"       Color="#2E2C2A"/>

    <!-- ============== Text ============== -->
    <SolidColorBrush x:Key="PrimaryTextBrush"   Color="#F0ECE4"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8B0A4"/>
    <SolidColorBrush x:Key="TertiaryTextBrush"  Color="#756E65"/>

    <!-- ============== Borders / dividers ============== -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2EFFFFFF"/>  <!-- rgba(255,255,255,.18) -->
    <SolidColorBrush x:Key="DividerBrush"    Color="#24FFFFFF"/>  <!-- ~0.14 -->
    <SolidColorBrush x:Key="LineSoftBrush"   Color="#24FFFFFF"/>

    <!-- ============== Accent ============== -->
    <SolidColorBrush x:Key="AccentBrush"     Color="#D88550"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A2D22"/>

    <!-- ============== POS pill ============== -->
    <SolidColorBrush x:Key="PosBadgeBackgroundBrush" Color="#14FFFFFF"/> <!-- rgba(255,255,255,.08) -->
    <SolidColorBrush x:Key="PosBadgeForegroundBrush" Color="#F0ECE4"/>

    <!-- ============== Hover / pick highlights ============== -->
    <SolidColorBrush x:Key="HoverHighlightBrush" Color="#7A4E3A"/>
    <SolidColorBrush x:Key="PickHighlightBrush"  Color="#A85528"/>

    <!-- ============== Status ============== -->
    <SolidColorBrush x:Key="OkBrush"  Color="#7BC18F"/>
    <SolidColorBrush x:Key="BadBrush" Color="#E07355"/>

    <!-- ============== Buttons ============== -->
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"  Color="#0DFFFFFF"/> <!-- rgba(255,255,255,.05) -->

    <!-- ============== Card shadow — отключена в dark ============== -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#000000"
                      Opacity="0"
                      BlurRadius="0"
                      ShadowDepth="0"/>

</ResourceDictionary>
